{
  "name": "league-one",
  "version": "2.0.0",
  "private": true,
  "description": "League One mobile-first fantasy football website",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @l1/site dev",
    "build": "pnpm --filter @l1/site build",
    "start": "pnpm --filter @l1/site start",
    "lint": "pnpm --filter @l1/site lint",
    "typecheck": "pnpm --filter @l1/site typecheck",
    "test": "pnpm --filter @l1/site test",
    "test:browser": "pnpm --filter @l1/site test:browser",
    "db:migrate": "pnpm --filter @l1/site db:migrate",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  }
}
