# Private server-side key for Tank01 NFL projections through RapidAPI.
TANK01_API_KEY=

# Restricted pooled Neon PostgreSQL connection string for the `league_one_runtime` role.
# Provision its grants with apps/site/scripts/provision-runtime-role.sql.
# Remote URLs must include sslmode=require (or a stronger verification mode).
DATABASE_URL=

# Privileged direct Neon connection used only by `pnpm db:migrate`.
# This must use the schema-owner role and is never used by the application runtime.
MIGRATION_DATABASE_URL=

# Long random value used by Vercel Cron to authenticate projection syncs.
CRON_SECRET=
