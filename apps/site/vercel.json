{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "build": {
    "env": {
      "ENABLE_EXPERIMENTAL_COREPACK": "1"
    }
  },
  "crons": [
    {
      "path": "/api/cron/live-projections",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/lineup-observations",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/future-projections",
      "schedule": "* * * * *"
    }
  ]
}
